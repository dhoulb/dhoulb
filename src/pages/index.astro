---
const title = "Dave Houlbrooke";
const links = [
	{ label: "GitHub", href: "https://github.com/dhoulb" },
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/dhoulb" },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#140b05" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preload" as="image" href="/dave.webp" type="image/webp" />
		<title>{title}</title>
		<meta name="description" content="Dave Houlbrooke. Product engineering, climbing, design." />
	</head>
	<body>
		<canvas id="dots" aria-hidden="true"></canvas>
		<main>
			<picture>
				<source srcset="/dave.webp" type="image/webp" />
				<img src="/dave.jpg" alt="Dave Houlbrooke" width="160" height="160" />
			</picture>
			<h1>{title}</h1>
			<p>Product engineering, climbing, design.</p>
			<ul>
				{
					links.map(({ label, href }) => (
						<li>
							<a href={href} rel="me">
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</main>
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}
	html,
	body {
		margin: 0;
		min-height: 100%;
		background: #140b05;
		color: #fff4ea;
		font-family:
			system-ui,
			-apple-system,
			"Segoe UI",
			Roboto,
			sans-serif;
	}
	body {
		display: grid;
		place-items: center;
		min-height: 100vh;
		min-height: 100dvh;
		padding: 24px 16px;
	}
	#dots {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	main {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
		padding: 40px 48px;
		border-radius: 28px;
		background: rgb(20 11 5 / 0.72);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		box-shadow: 0 0 0 1px rgb(255 140 40 / 0.18);
		text-align: center;
	}
	@media (max-width: 480px) {
		main {
			padding: 32px 24px;
		}
	}
	img {
		display: block;
		width: 160px;
		height: 160px;
		border-radius: 50%;
		object-fit: cover;
		box-shadow:
			0 0 0 3px #140b05,
			0 0 0 5px #ff8a1f;
	}
	h1 {
		margin: 4px 0 0;
		font-size: 2rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	p {
		margin: -12px 0 4px;
		color: rgb(255 244 234 / 0.75);
		font-size: 1.05rem;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		justify-content: center;
		gap: 12px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: inline-block;
		padding: 10px 20px;
		border-radius: 999px;
		border: 1px solid rgb(255 138 31 / 0.6);
		color: #fff4ea;
		text-decoration: none;
		font-weight: 600;
		transition:
			background-color 0.2s,
			color 0.2s;
	}
	a:hover,
	a:focus-visible {
		background: #ff8a1f;
		color: #140b05;
		outline: none;
	}
</style>

<script>
	const canvas = document.getElementById("dots") as HTMLCanvasElement;
	const ctx = canvas.getContext("2d")!;
	const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

	const GAP = 28; // Space between dots (px).
	const SIZE = 2.2; // Dot radius at rest (px).
	const REACH = 150; // Mouse range (px).
	const PUSH = 18; // Max push away from mouse (px).
	const GROW = 2.4; // Max size multiplier near mouse.
	const PULL = 0.025; // Magnet strength.
	const MAX_PULL = 1.4; // Max magnet acceleration (px per frame²).
	const CELL = 8; // Collision grid cell size (px), must be at least one dot diameter.

	type Dot = { hx: number; hy: number; x: number; y: number; vx: number; vy: number; s: number };
	let dots: Dot[] = [];
	let width = 0;
	let height = 0;
	let mouseX = -9999;
	let mouseY = -9999;
	let magnet = false;
	let frame = 0;

	function resize() {
		const ratio = Math.min(window.devicePixelRatio || 1, 2);
		width = window.innerWidth;
		height = window.innerHeight;
		canvas.width = Math.round(width * ratio);
		canvas.height = Math.round(height * ratio);
		ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
		dots = [];
		const cols = Math.ceil(width / GAP) + 1;
		const rows = Math.ceil(height / GAP) + 1;
		const offsetX = (width - (cols - 1) * GAP) / 2;
		const offsetY = (height - (rows - 1) * GAP) / 2;
		for (let row = 0; row < rows; row++) {
			for (let col = 0; col < cols; col++) {
				const x = offsetX + col * GAP;
				const y = offsetY + row * GAP;
				dots.push({ hx: x, hy: y, x, y, vx: 0, vy: 0, s: 1 });
			}
		}
	}

	// Colour drifts softly from bright orange to burnt orange across the page.
	function colour(x: number, y: number, t: number) {
		const wave =
			Math.sin(x * 0.004 + t * 0.00035) * 0.5 +
			Math.sin(y * 0.005 - t * 0.00025) * 0.3 +
			Math.sin((x + y) * 0.002 + t * 0.0002) * 0.2;
		const k = (wave + 1) / 2; // 0 = burnt orange, 1 = bright orange.
		const hue = 20 + k * 14;
		const light = 40 + k * 15;
		return `hsl(${hue.toFixed(1)} 100% ${light.toFixed(1)}%)`;
	}

	// Push overlapping dots apart, using a spatial hash so each dot only checks its neighbours.
	function collide() {
		const grid = new Map<number, Dot[]>();
		const key = (cx: number, cy: number) => cx * 100003 + cy;
		for (const dot of dots) {
			const k = key(Math.floor(dot.x / CELL), Math.floor(dot.y / CELL));
			const cell = grid.get(k);
			if (cell) cell.push(dot);
			else grid.set(k, [dot]);
		}
		for (const a of dots) {
			const cx = Math.floor(a.x / CELL);
			const cy = Math.floor(a.y / CELL);
			for (let ox = -1; ox <= 1; ox++) {
				for (let oy = -1; oy <= 1; oy++) {
					const cell = grid.get(key(cx + ox, cy + oy));
					if (!cell) continue;
					for (const b of cell) {
						if (b === a) continue;
						const dx = b.x - a.x;
						const dy = b.y - a.y;
						const min = SIZE * (a.s + b.s);
						const d2 = dx * dx + dy * dy;
						if (d2 >= min * min) continue;
						const d = Math.sqrt(d2) || 0.01;
						const push = (min - d) / d / 2;
						a.x -= dx * push;
						a.y -= dy * push;
						b.x += dx * push;
						b.y += dy * push;
					}
				}
			}
		}
	}

	function step() {
		for (const dot of dots) {
			let ts = 1;
			if (magnet) {
				// Pull every dot towards the mouse.
				const ax = mouseX - dot.x;
				const ay = mouseY - dot.y;
				const dist = Math.hypot(ax, ay) || 1;
				const force = Math.min(dist * PULL, MAX_PULL);
				dot.vx = (dot.vx + (ax / dist) * force) * 0.86;
				dot.vy = (dot.vy + (ay / dist) * force) * 0.86;
			} else {
				// Spring back home, pushed away from the mouse.
				let tx = dot.hx;
				let ty = dot.hy;
				const ax = dot.hx - mouseX;
				const ay = dot.hy - mouseY;
				const dist = Math.hypot(ax, ay);
				if (dist < REACH) {
					const f = 1 - dist / REACH;
					const ease = f * f * (3 - 2 * f);
					const len = dist || 1;
					tx += (ax / len) * PUSH * ease;
					ty += (ay / len) * PUSH * ease;
					ts = 1 + (GROW - 1) * ease;
				}
				dot.vx = (dot.vx + (tx - dot.x) * 0.06) * 0.8;
				dot.vy = (dot.vy + (ty - dot.y) * 0.06) * 0.8;
			}
			dot.x += dot.vx;
			dot.y += dot.vy;
			dot.s += (ts - dot.s) * 0.12;
		}
		collide();
		collide();
	}

	function draw(t: number) {
		ctx.clearRect(0, 0, width, height);
		for (const dot of dots) {
			ctx.fillStyle = colour(dot.hx, dot.hy, t);
			ctx.beginPath();
			ctx.arc(dot.x, dot.y, SIZE * dot.s, 0, Math.PI * 2);
			ctx.fill();
		}
	}

	function loop(t: number) {
		step();
		draw(t);
		frame = requestAnimationFrame(loop);
	}

	function start() {
		cancelAnimationFrame(frame);
		resize();
		if (reduced.matches) draw(0);
		else frame = requestAnimationFrame(loop);
	}

	function away() {
		mouseX = -9999;
		mouseY = -9999;
		magnet = false;
	}

	window.addEventListener("resize", start);
	reduced.addEventListener("change", start);
	window.addEventListener("pointermove", (e) => {
		mouseX = e.clientX;
		mouseY = e.clientY;
	});
	window.addEventListener("pointerup", (e) => {
		if (e.pointerType !== "mouse") away();
	});
	document.addEventListener("pointerleave", away);
	window.addEventListener("blur", away);
	for (const link of document.querySelectorAll("main a")) {
		link.addEventListener("pointerenter", () => (magnet = true));
		link.addEventListener("pointerleave", () => (magnet = false));
	}
	start();
</script>
