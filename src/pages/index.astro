---
const title = "Dave Houlbrooke";
const links = [
	{ label: "GitHub", href: "https://github.com/dhoulb" },
	{ label: "LinkedIn", href: "https://www.linkedin.com/in/dhoulb" },
	{ label: "Instagram", href: "https://www.instagram.com/dhoulb" },
];
---

<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1, maximum-scale=1, user-scalable=no, viewport-fit=cover" />
		<meta name="color-scheme" content="dark" />
		<meta name="theme-color" content="#140b05" />
		<link rel="icon" href="/favicon.ico" sizes="48x48" />
		<link rel="icon" type="image/png" href="/favicon.png" />
		<link rel="apple-touch-icon" href="/apple-touch-icon.png" />
		<link rel="preload" as="image" href="/dave.webp" type="image/webp" />
		<link rel="canonical" href="https://dhoulb.com/" />
		<title>{title}</title>
		<meta name="description" content="Dave Houlbrooke. Product engineering, climbing, design." />
	</head>
	<body>
		<canvas id="dots" aria-hidden="true"></canvas>
		<main>
			<div class="avatar">
				<div class="flip">
					<picture>
						<source srcset="/dave.webp" type="image/webp" />
						<img draggable="false" src="/dave.jpg" alt="Dave Houlbrooke" width="160" height="160" />
					</picture>
					<img draggable="false" class="back" src="/dh.webp" alt="" width="160" height="160" />
				</div>
			</div>
			<h1>{title}</h1>
			<p>Product engineering, climbing, design.</p>
			<ul>
				{
					links.map(({ label, href }) => (
						<li>
							<a href={href} rel="me" draggable="false">
								{label}
							</a>
						</li>
					))
				}
			</ul>
		</main>
	</body>
</html>

<style is:global>
	* {
		box-sizing: border-box;
	}
	html,
	body {
		margin: 0;
		height: 100%;
		/* Lock the page: no scroll, no zoom, no text select. Finger drags only move the dots. */
		overflow: hidden;
		overscroll-behavior: none;
		touch-action: none;
		user-select: none;
		-webkit-user-select: none;
		-webkit-touch-callout: none;
		-webkit-tap-highlight-color: transparent;
		background: #140b05;
		color: #fff4ea;
		font-family:
			system-ui,
			-apple-system,
			"Segoe UI",
			Roboto,
			sans-serif;
	}
	body {
		position: fixed;
		inset: 0;
		display: grid;
		place-items: center;
		padding: 24px 16px;
	}
	img {
		-webkit-user-drag: none;
	}
	#dots {
		position: fixed;
		inset: 0;
		width: 100%;
		height: 100%;
		display: block;
	}
	main {
		position: relative;
		display: flex;
		flex-direction: column;
		align-items: center;
		gap: 20px;
		padding: 40px 48px;
		border-radius: 28px;
		background: rgb(20 11 5 / 0.72);
		backdrop-filter: blur(6px);
		-webkit-backdrop-filter: blur(6px);
		box-shadow: 0 0 0 1px rgb(255 140 40 / 0.18);
		text-align: center;
	}
	@media (max-width: 480px) {
		main {
			padding: 32px 24px;
		}
	}
	img {
		display: block;
		width: 160px;
		height: 160px;
		border-radius: 50%;
		object-fit: cover;
		box-shadow:
			0 0 0 3px #140b05,
			0 0 0 5px #ff8a1f;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
	}
	.avatar {
		perspective: 800px;
	}
	.flip {
		position: relative;
		transform-style: preserve-3d;
		/* Overshoot easing gives a slight overspin, then settles back. */
		transition: transform 1.6s cubic-bezier(0.3, 1.15, 0.5, 1);
	}
	.flip > picture {
		display: block;
		backface-visibility: hidden;
		-webkit-backface-visibility: hidden;
	}
	.flip .back {
		position: absolute;
		inset: 0;
		transform: rotateX(180deg);
	}
	.avatar:hover .flip {
		transform: rotateX(900deg);
	}
	@media (prefers-reduced-motion: reduce) {
		.flip {
			transition: none;
		}
	}
	h1 {
		margin: 4px 0 0;
		font-size: 2rem;
		font-weight: 700;
		letter-spacing: -0.01em;
	}
	p {
		margin: -12px 0 4px;
		color: rgb(255 244 234 / 0.75);
		font-size: 1.05rem;
	}
	ul {
		display: flex;
		flex-direction: column;
		align-self: stretch;
		gap: 12px;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	a {
		display: block;
		padding: 10px 20px;
		border-radius: 999px;
		border: 1px solid rgb(255 138 31 / 0.6);
		color: #fff4ea;
		text-decoration: none;
		font-weight: 600;
		transition:
			background-color 0.2s,
			color 0.2s;
	}
	a:hover,
	a:focus-visible {
		background: #ff8a1f;
		color: #140b05;
		outline: none;
	}
</style>

<script>
	const canvas = document.getElementById("dots") as HTMLCanvasElement;
	const ctx = canvas.getContext("2d")!;
	const reduced = window.matchMedia("(prefers-reduced-motion: reduce)");

	const GAP = 28; // Space between dots (px).
	const SIZE = 2.2; // Dot radius at rest (px).
	const REACH = 230; // Mouse range (px).
	const PUSH = 32; // Max push away from mouse (px).
	const GROW = 3.2; // Max size multiplier near mouse.
	const SPRING = 0.06; // Spring strength.
	const DAMP = 0.8; // Velocity kept each frame.
	const WAVE_EVERY = 2000; // Time between waves while a link is hovered (ms).
	const WAVE_SPEED = 0.45; // Wave speed (px per ms).
	const WAVE_WIDTH = 70; // Wave band width (px).
	const WAVE_LIFE = 3000; // Time until a wave fades out (ms).
	const WAVE_PUSH = 6; // Wave push outwards (px).
	const WAVE_GROW = 0.35; // Wave size increase (fraction).

	type Dot = { hx: number; hy: number; x: number; y: number; vx: number; vy: number; s: number };
	type Wave = { x: number; y: number; t: number };
	let dots: Dot[] = [];
	let waves: Wave[] = [];
	let width = 0;
	let height = 0;
	let mouseX = -9999;
	let mouseY = -9999;
	let hovering = false;
	let lastWave = 0;
	let frame = 0;

	function resize() {
		const ratio = Math.min(window.devicePixelRatio || 1, 2);
		width = window.innerWidth;
		height = window.innerHeight;
		canvas.width = Math.round(width * ratio);
		canvas.height = Math.round(height * ratio);
		ctx.setTransform(ratio, 0, 0, ratio, 0, 0);
		dots = [];
		const cols = Math.ceil(width / GAP) + 1;
		const rows = Math.ceil(height / GAP) + 1;
		const offsetX = (width - (cols - 1) * GAP) / 2;
		const offsetY = (height - (rows - 1) * GAP) / 2;
		for (let row = 0; row < rows; row++) {
			for (let col = 0; col < cols; col++) {
				const x = offsetX + col * GAP;
				const y = offsetY + row * GAP;
				dots.push({ hx: x, hy: y, x, y, vx: 0, vy: 0, s: 1 });
			}
		}
	}

	// Colour drifts softly from bright orange to burnt orange across the page, and brightens towards white in a wave.
	function colour(x: number, y: number, t: number, glow: number) {
		const wave =
			Math.sin(x * 0.004 + t * 0.00035) * 0.5 +
			Math.sin(y * 0.005 - t * 0.00025) * 0.3 +
			Math.sin((x + y) * 0.002 + t * 0.0002) * 0.2;
		const k = (wave + 1) / 2; // 0 = burnt orange, 1 = bright orange.
		const hue = 20 + k * 14 + glow * 10;
		const light = 40 + k * 15;
		return `hsl(${hue.toFixed(1)} 100% ${(light + (96 - light) * glow).toFixed(1)}%)`;
	}

	// How strongly each wave touches a point (0–1), and the push direction.
	function waveAt(x: number, y: number, t: number) {
		let glow = 0;
		let px = 0;
		let py = 0;
		for (const w of waves) {
			const age = t - w.t;
			const dx = x - w.x;
			const dy = y - w.y;
			const dist = Math.hypot(dx, dy) || 1;
			const off = (dist - age * WAVE_SPEED) / WAVE_WIDTH;
			if (off < -2 || off > 2) continue;
			const g = Math.exp(-off * off * 2) * (1 - age / WAVE_LIFE);
			glow += g;
			px += (dx / dist) * g;
			py += (dy / dist) * g;
		}
		return { glow: Math.min(glow, 1), px, py };
	}

	function step(t: number) {
		if (hovering && t - lastWave >= WAVE_EVERY) {
			waves.push({ x: mouseX, y: mouseY, t });
			lastWave = t;
		}
		waves = waves.filter((w) => t - w.t < WAVE_LIFE);
		ctx.clearRect(0, 0, width, height);
		for (const dot of dots) {
			// Rest at home, pushed away from the mouse.
			let tx = dot.hx;
			let ty = dot.hy;
			let ts = 1;
			const ax = dot.hx - mouseX;
			const ay = dot.hy - mouseY;
			const dist = Math.hypot(ax, ay);
			if (dist < REACH) {
				const f = 1 - dist / REACH;
				const ease = f * f * (3 - 2 * f);
				const len = dist || 1;
				tx += (ax / len) * PUSH * ease;
				ty += (ay / len) * PUSH * ease;
				ts = 1 + (GROW - 1) * ease;
			}
			// Waves push outwards, grow and brighten the dots they pass.
			const { glow, px, py } = waveAt(dot.hx, dot.hy, t);
			tx += px * WAVE_PUSH;
			ty += py * WAVE_PUSH;
			ts *= 1 + WAVE_GROW * glow;
			dot.vx = (dot.vx + (tx - dot.x) * SPRING) * DAMP;
			dot.vy = (dot.vy + (ty - dot.y) * SPRING) * DAMP;
			dot.x += dot.vx;
			dot.y += dot.vy;
			dot.s += (ts - dot.s) * 0.2;
			ctx.fillStyle = colour(dot.hx, dot.hy, t, glow);
			ctx.beginPath();
			ctx.arc(dot.x, dot.y, SIZE * dot.s, 0, Math.PI * 2);
			ctx.fill();
		}
	}

	function drawStill() {
		ctx.clearRect(0, 0, width, height);
		for (const dot of dots) {
			ctx.fillStyle = colour(dot.hx, dot.hy, 0, 0);
			ctx.beginPath();
			ctx.arc(dot.x, dot.y, SIZE, 0, Math.PI * 2);
			ctx.fill();
		}
	}

	function loop(t: number) {
		step(t);
		frame = requestAnimationFrame(loop);
	}

	function start() {
		cancelAnimationFrame(frame);
		resize();
		if (reduced.matches) drawStill();
		else frame = requestAnimationFrame(loop);
	}

	function away() {
		mouseX = -9999;
		mouseY = -9999;
		hovering = false;
	}

	window.addEventListener("resize", start);
	reduced.addEventListener("change", start);
	window.addEventListener("pointermove", (e) => {
		mouseX = e.clientX;
		mouseY = e.clientY;
	});
	window.addEventListener("pointerup", (e) => {
		if (e.pointerType !== "mouse") away();
	});
	document.addEventListener("pointerleave", away);
	window.addEventListener("blur", away);
	// iOS Safari ignores user-scalable=no, so block pinch zoom here too.
	document.addEventListener("gesturestart", (e) => e.preventDefault());
	for (const link of document.querySelectorAll("main a")) {
		link.addEventListener("pointerenter", (e) => {
			mouseX = (e as PointerEvent).clientX;
			mouseY = (e as PointerEvent).clientY;
			hovering = true;
			lastWave = -Infinity; // First wave starts at once.
		});
		link.addEventListener("pointerleave", () => (hovering = false));
	}
	start();
</script>
